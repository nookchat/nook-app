{
  "name": "nook-desktop",
  "productName": "Nook",
  "private": true,
  "version": "0.3.20",
  "description": "Nook for the desktop: chat, voice and screen sharing.",
  "main": "main.cjs",
  "author": "Nook",
  "scripts": {
    "start": "electron .",
    "dev": "NOOK_URL=http://localhost:5173 electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.nook.desktop",
    "productName": "Nook",
    "files": [
      "*.cjs",
      "picker.html",
      "splash.html",
      "tray.png",
      "tray@1.25x.png",
      "tray@1.5x.png",
      "tray@1.75x.png",
      "tray@2x.png",
      "tray@2.5x.png",
      "tray@3x.png",
      "tray@4x.png",
      "fonts/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nook uses the microphone for voice channels.",
        "NSCameraUsageDescription": "Nook uses the camera when you turn it on.",
        "NSScreenCaptureUsageDescription": "Nook shares your screen when you ask it to.",
        "NSAppleEventsUsageDescription": "Nook asks Spotify which song it plays, to show it to the people in your spaces when you turn that on."
      },
      "identity": "-"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "mimeTypes": [
        "x-scheme-handler/nook"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "protocols": [
      {
        "name": "Nook link",
        "schemes": [
          "nook"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nookchat",
        "repo": "nook-app",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
