# Nook server settings. The installer writes this for you:
#
#   curl -fsSL https://raw.githubusercontent.com/nookchat/nook-app/main/server/install.sh | sh
#
# Only the domain is needed. To change a default, remove the # and run: docker compose up -d

# The server's domain. Point its DNS at this machine first.
CATHODE_DOMAIN=cathode.example.org

# Long random strings, made by the installer (openssl rand -hex 32).
POSTGRES_PASSWORD=
CATHODE_TURN_SECRET=

# Extras: tls for HTTPS (Caddy), turn for calls (coturn).
# Without tls (your own proxy), set CATHODE_BIND=0.0.0.0.
COMPOSE_PROFILES=tls,turn

# --- optional ---

# Pages that may use this server, comma separated. * is any page.
# CATHODE_ORIGINS=*

# The server's public address. Default: https:// and the domain.
# CATHODE_PUBLIC_URL=https://cathode.example.org

# 0 lets a call try a direct path before the TURN relay.
# CATHODE_TURN_ONLY=1

# A cluster with friends: their servers, and one shared secret.
# CATHODE_PEERS=https://friend-one.example.org,https://friend-two.example.org
# CATHODE_CLUSTER_SECRET=

# Byte limits: one file, and all files in one space.
# CATHODE_MAX_FILE_BYTES=104857600
# CATHODE_MAX_ROOM_FILE_BYTES=5368709120

# GIF search. Set one key; the first set here is used.
#   Klipy: https://partner.klipy.com/api-keys
#   Tenor: https://developers.google.com/tenor
#   Giphy: https://developers.giphy.com
# CATHODE_KLIPY_KEY=
# CATHODE_TENOR_KEY=
# CATHODE_GIPHY_KEY=
