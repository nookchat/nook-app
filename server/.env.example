# Copy to server/.env and fill in. docker compose reads it from there.

# The name this server answers on. Point its DNS at this machine first.
CATHODE_DOMAIN=cathode.example.org

# The pages that may use this server, comma separated. * is any page.
CATHODE_ORIGINS=https://cathode.example.vercel.app

# The database password. Make a long random one: openssl rand -hex 24
POSTGRES_PASSWORD=

# TURN. Make a long random secret, for example: openssl rand -hex 32
CATHODE_TURN_SECRET=
CATHODE_TURN_URLS=turn:cathode.example.org:3478?transport=udp,turn:cathode.example.org:3478?transport=tcp
# Every call in a space on this server goes through TURN, so media never goes
# straight between people. 0 lets a call try a direct path first.
CATHODE_TURN_ONLY=1

# The cluster. Leave CATHODE_PEERS empty to run on your own.
#   CATHODE_PUBLIC_URL      this server's own address, as the others reach it
#   CATHODE_PEERS           the others, comma separated
#   CATHODE_CLUSTER_SECRET  the same on every server in the cluster, 16 characters or more
CATHODE_PUBLIC_URL=https://cathode.example.org
CATHODE_PEERS=
CATHODE_CLUSTER_SECRET=

# Which profiles to start: tls for Caddy, turn for coturn.
COMPOSE_PROFILES=tls,turn
