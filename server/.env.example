# Copy to server/.env and fill in. docker compose reads it from there.

# The name this server answers on. Point its DNS at this machine first.
CATHODE_DOMAIN=cathode.example.org

# The pages that may use this server, comma separated. * is any page.
CATHODE_ORIGINS=https://cathode.example.vercel.app

# TURN. Make a long random secret, for example: openssl rand -hex 32
CATHODE_TURN_SECRET=
CATHODE_TURN_URLS=turn:cathode.example.org:3478?transport=udp,turn:cathode.example.org:3478?transport=tcp
# 1 sends every call through TURN, so nobody learns anybody else's address.
CATHODE_TURN_ONLY=0

# Which profiles to start: tls for Caddy, turn for coturn.
COMPOSE_PROFILES=tls,turn
