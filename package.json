{
  "name": "cathode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Peer to peer screen share with audio. No server except the static host.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e.mjs",
    "test:mesh": "node test/mesh.mjs",
    "test:repro": "node test/repro.mjs",
    "test:relays": "node test/relay-probe.mjs",
    "test:relay": "node test/relay-check.mjs",
    "test:selfrelay": "node test/self-relay-check.mjs",
    "test:qr": "node test/qr-check.mjs",
    "test:uplink": "node test/uplink.mjs",
    "test:encoder": "node test/encoder-check.mjs",
    "test:cpu": "node test/cpu-check.mjs",
    "test:fallback": "node test/codec-fallback.mjs",
    "test:url": "node test/url-check.mjs",
    "test:persist": "node test/persist-check.mjs",
    "test:voice": "node test/voice-check.mjs",
    "test:storage": "node test/storage-check.mjs",
    "test:roles": "node test/roles-check.mjs",
    "test:live": "node test/live-check.mjs",
    "test:rejoin": "node test/rejoin-check.mjs",
    "test:denoise": "node test/denoise-check.mjs",
    "test:converge": "node test/converge-check.mjs",
    "test:sync": "node test/sync-check.mjs",
    "test:agree": "node test/agree-check.mjs",
    "test:archive": "node test/archive-check.mjs",
    "test:leave": "node test/leave-check.mjs",
    "test:emoji": "node test/emoji-check.mjs",
    "test:chat": "node test/chat-check.mjs",
    "test:extras": "node test/extras-check.mjs",
    "test:polish": "node test/polish-check.mjs",
    "test:board": "node test/board-check.mjs"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@noble/curves": "^1.9.0"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
