{
  "name": "nook",
  "private": true,
  "version": "0.3.14",
  "type": "module",
  "description": "Screen share, voice and chat. Peer to peer, or on a Nook server you run.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "server": "node server/server.mjs",
    "stack": "node test/stack.mjs",
    "test": "node test/run.mjs",
    "speed": "node test/speed.mjs",
    "bench": "node test/server-bench.mjs",
    "file-speed": "node test/file-speed.mjs",
    "tour": "node test/tour.mjs",
    "desktop": "npm --prefix desktop run dev",
    "desktop:dist": "npm --prefix desktop run dist"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@noble/curves": "^1.9.0",
    "@tldraw/assets": "^5.5.0",
    "mediabunny": "^1.60.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldraw": "^5.5.0",
    "twemoji-art": "https://codeload.github.com/jdecked/twemoji/tar.gz/refs/tags/v17.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
